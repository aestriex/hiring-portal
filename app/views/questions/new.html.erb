<div class="max-w-2xl mx-auto px-6 py-12">
    <h1 class="text-2xl font-semibold text-foreground mb-8">Add Question to <%= @section.title %>
    </h1>

    <%= form_with model: @question, url: job_posting_section_questions_path(@job_posting, @section), class: "space-y-6" do |form| %>
        <div>
            <%= form.label :label, "Question Text" , class: "block font-medium text-foreground mb-1" %>
                <%= form.text_field :label, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
        </div>

        <div>
            <%= form.label :question_type, "Question Type" , class: "block font-medium text-foreground mb-1" %>
                <%= form.select :question_type, Question::QUESTION_TYPES, {},
                    class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
        </div>

        <div class="flex items-center gap-2">
            <%= form.check_box :required %>
                <%= form.label :required, class: "font-medium text-foreground" %>
        </div>

        <div>
            <%= form.label :position, class: "block font-medium text-foreground mb-1" %>
                <%= form.number_field :position, class: "w-full border border-input rounded-md px-4 py-2 bg-background"
                    %>
        </div>

        <%= render_button "Add Question" , type: :submit %>
            <% end %>
</div>