<div class="max-w-4xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Job Postings</h1>

  <div class="flex flex-row gap-4">
    <% @job_postings.each do |posting| %>
      <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition flex justify-center flex-col">
        <h2 class="text-lg font-semibold text-gray-900"><%= posting.title %></h2>
        <p class="text-gray-500"><%= posting.department %></p>
        <%= render_button "Click me" %>
      </div>
    <% end %>
  </div>
</div>