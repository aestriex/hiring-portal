<div class="max-w-3xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold text-foreground mb-2">
    <%= @job_posting.title %>
  </h1>
  <p class="text-muted-foreground mb-6">
    <%= @job_posting.department %>
  </p>
  <p class="text-foreground leading-relaxed mb-6">
    <%= @job_posting.description %>
  </p>

  <%= render_button "Add Section" , as: :link, href: new_job_posting_section_path(@job_posting), variant: :outline %>

    <% @job_posting.sections.order(:position).each do |section| %>
      <div class="mt-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-foreground">
            <%= section.title %>
          </h2>
          <%= render_button "Add Question" , as: :link, href: new_job_posting_section_question_path(@job_posting,
            section), variant: :secondary %>
        </div>

        <% section.questions.order(:position).each do |question| %>
          <div class="mb-3 p-4 bg-muted rounded-lg">
            <p class="font-medium text-foreground">
              <%= question.label %>
            </p>
            <p class="text-sm text-muted-foreground">Type: <%= question.question_type %>
                <%= "(required)" if question.required %>
            </p>
          </div>
          <% end %>
      </div>
      <% end %>
</div>