<div class="max-w-3xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold text-foreground mb-2">
    <%= @job_posting.title %>
  </h1>
  <p class="text-muted-foreground mb-6">
    <%= @job_posting.department %>
  </p>
  <p class="text-foreground leading-relaxed mb-6">
    <%= @job_posting.description %>
  </p>

  <%= turbo_frame_tag "new_section" do %>
    <%= render_button as: :link, href: new_job_posting_section_path(@job_posting), variant: :outline do %>
      <%= lucide_icon "plus", class: "w-4 h-4 mr-2" %> Add Section
    <% end %>
  <% end %>

  <div id="sections" data-controller="sortable" data-sortable-url-value="<%= reorder_job_posting_sections_path(@job_posting) %>">
    <% @job_posting.sections.order(:position).each do |section| %>
      <%= render "sections/section", section: section, job_posting: @job_posting %>
    <% end %>
  </div>
</div>