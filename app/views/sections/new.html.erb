<div class="max-w-2xl mx-auto px-6 py-12">
    <h1 class="text-2xl font-semibold text-foreground mb-8">Add Section to <%= @job_posting.title %>
    </h1>

    <%= form_with model: @section, url: job_posting_sections_path(@job_posting), class: "space-y-6" do |form| %>
        <div>
            <%= form.label :title, class: "block font-medium text-foreground mb-1" %>
                <%= form.text_field :title, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
        </div>

        <div>
            <%= form.label :position, class: "block font-medium text-foreground mb-1" %>
                <%= form.number_field :position, class: "w-full border border-input rounded-md px-4 py-2 bg-background"
                    %>
        </div>

        <%= render_button "Add Section" , type: :submit %>
            <% end %>
</div>